{
  "name": "react-country-maps",
  "version": "0.1.0",
  "description": "A collection of React components for displaying country maps",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./countries/*": {
      "types": "./dist/countries/*/index.d.ts",
      "default": "./dist/countries/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:country": "tsx scripts/build-country.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/knetic0/react-country-maps"
  },
  "keywords": [
    "country-maps",
    "react",
    "country-maps-react",
    "maps",
    "countries",
    "svg",
    "interactive"
  ],
  "author": "Mehmet Solak <solakmehmet02@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/knetic0/react-country-maps#readme",
  "bugs": {
    "url": "https://github.com/knetic0/react-country-maps/issues"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "mapshaper": "^0.7.83",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4"
  }
}
